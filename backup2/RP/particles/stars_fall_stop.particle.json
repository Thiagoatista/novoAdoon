{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "parkour:stars_fall_stop",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 8
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.5, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.75, 1.25)"
			},
			"minecraft:particle_initial_speed": "math.random(5, 10)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "-10 - (variable.particle_random_3 * 10)", 0],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.05 + (0.1 * variable.particle_random_2)", "0.05 + (0.1 * variable.particle_random_2)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [0, 96],
						"size_UV": [8, 8],
						"step_UV": [8, 0],
						"frames_per_second": 7,
						"max_frame": 7,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.05
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.53": "#ffffffff",
						"0.6": "#00FFFFFF",
						"0.67": "#ffffffff",
						"0.96": "#00FFFFFF"
					}
				}
			}
		}
	}
}