{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "parkour:penas_explode_pintinho_stum",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/penas_pintinha_explode_stum"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random(1, 3)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": "(v.particle_random_1 < 0.5) ? (math.sin(v.particle_age * 360) * 50 + (v.particle_random_2 * 360)) : (math.sin(math.clamp(v.particle_age * 3, 0, 1) * 90) * 360)"
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -1.5, 0],
				"linear_drag_coefficient": 5.5
			},
			"minecraft:particle_motion_parametric": {
				"rotation": "v.particle_random_1 < 0.33 ? (math.sin(v.particle_age * 160) * 45 + (v.particle_random_2 * 360)) : (v.particle_random_1 < 0.66 ? (v.particle_age * (720 - v.particle_age * 180) + (v.particle_random_2 * 360)) : (-v.particle_age * (270 - v.particle_age * 45) + (v.particle_random_2 * 360)))"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.15, 0.15],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["Math.floor(v.particle_random_3 * 2) * 8", "Math.floor(v.particle_random_4 * 2) * 8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.05
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}